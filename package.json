{
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "chromedriver": "^138.0.5",
    "selenium-webdriver": "^4.33.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "concurrently": "^9.2.0",
    "kill-port": "^2.0.1",
    "mocha": "^11.7.1",
    "playwright": "^1.54.2",
    "tsx": "^4.20.3"
  },
  "name": "playwright_wam",
  "description": "\"# playwright_wam\"",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "mock-api": "kill-port 3000 && json-server db.json --port 3000",
    "test:api": "playwright test Tests/API",
    "test:api:run": "concurrently -k -s first -n \"API,TEST\" -c green,blue \"npm run mock-api\" \"npm run test:api\"",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "codegen": "npx playwright codegen",
    "install:browsers": "npx playwright install",
    "report": "npx playwright show-report reports",
    "setup:db": "node setup-db.js",
    "test:with-db": "npm run setup:db && npx playwright test Tests/DB"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wwamia/playwright_wam.git"
  },
  "keywords": [],
  "author": "",
